<Window x:Class="Video.Views.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理性質與演員" Height="580" Width="660" MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="GenreTab" Style="{StaticResource SegmentTab}" GroupName="Kind" IsChecked="True" Content="性質" Checked="Tab_Checked" />
                <RadioButton x:Name="ActorTab" Style="{StaticResource SegmentTab}" GroupName="Kind" Content="演員" Checked="Tab_Checked" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <!-- 左：清單 -->
            <Border Style="{StaticResource Card}" Padding="12,14">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Style="{StaticResource SearchBox}" Tag="篩選清單…"
                             Margin="0,0,0,10" TextChanged="FilterBox_TextChanged" />
                    <Grid>
                        <ListBox x:Name="NameList" Style="{StaticResource SideList}" SelectionChanged="NameList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Count, StringFormat={}{0} 部}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource EmptyText}" Visibility="Collapsed"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 右：操作 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="名稱" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" PreviewKeyDown="NameBox_PreviewKeyDown" />
                    <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="新增性質" Click="Add_Click" Margin="0,12,0,0" />
                    <Button x:Name="RenameButton" Content="改成這個名稱" Click="Rename_Click" Margin="0,8,0,0"
                            ToolTip="所有影片上的名字會一起改；改成已經有的名字就是合併" />
                    <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="刪除" Click="Delete_Click" Margin="0,8,0,0"
                            ToolTip="從所有影片移除這個名字，影片本身不會被刪除" />
                    <TextBlock x:Name="HintText" Style="{StaticResource HintText}" Margin="2,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
