<Window x:Class="Video.Views.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理性質與演員" Height="760" Width="680" MinHeight="520" MinWidth="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="GenreTab" Style="{StaticResource SegmentTab}" GroupName="Kind" IsChecked="True" Content="性質" Checked="Tab_Checked" />
                <RadioButton x:Name="ActorTab" Style="{StaticResource SegmentTab}" GroupName="Kind" Content="演員" Checked="Tab_Checked" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <!-- 左：清單（性質依大項排，小項縮排在大項下面） -->
            <Border Style="{StaticResource Card}" Padding="12,14">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Style="{StaticResource SearchBox}" Tag="篩選清單…"
                             Margin="0,0,0,10" TextChanged="FilterBox_TextChanged" />
                    <Grid>
                        <ListBox x:Name="NameList" Style="{StaticResource SideList}" SelectionChanged="NameList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="RowGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Branch" Text="└" Foreground="{StaticResource SubtleBrush}" Margin="4,0,8,0"
                                                   VerticalAlignment="Center" Visibility="Collapsed" />
                                        <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Count, StringFormat={}{0} 部}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Group">
                                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Sub">
                                            <Setter TargetName="Branch" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource EmptyText}" Visibility="Collapsed"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 右：操作 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <!-- 新增性質（演員是從影片來的，不用單獨新增）。放最上面，一打開就看得到 -->
                <Border x:Name="AddCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="新增性質" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NewNameBox" Style="{StaticResource SearchBox}" Tag="輸入名稱"
                                 PreviewKeyDown="NewNameBox_PreviewKeyDown" ToolTip="按 Enter 新增成大項" />
                        <Button x:Name="AddRootButton" Style="{StaticResource PrimaryButton}" Click="AddRoot_Click" Margin="0,10,0,0"
                                ToolTip="新增一個大項分類（Enter）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource ButtonIcon}" />
                                <TextBlock Text="新增成大項" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="或放在大項底下" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                        <ComboBox x:Name="NewParentBox" DisplayMemberPath="Display" />
                        <Button x:Name="AddSubButton" Click="AddSub_Click" Margin="0,8,0,0" ToolTip="新增到上面選的大項底下">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource ButtonIcon}" />
                                <TextBlock Text="新增成小項" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="NoRootText" Style="{StaticResource HintText}" Margin="2,8,0,0" Visibility="Collapsed"
                                   Text="還沒有大項，先新增一個大項，才能在底下加小項。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="選取的名稱" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" PreviewKeyDown="NameBox_PreviewKeyDown" />
                        <Button x:Name="RenameButton" Content="改成這個名稱" Click="Rename_Click" Margin="0,10,0,0"
                                ToolTip="所有影片上的名字會一起改；改成已經有的名字就是合併" />
                        <StackPanel x:Name="ParentPanel" Margin="0,14,0,0">
                            <TextBlock Text="所屬大項" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ParentBox" DisplayMemberPath="Display" SelectionChanged="ParentBox_SelectionChanged"
                                      ToolTip="選了就會移過去；選「沒有」就變成大項" />
                        </StackPanel>
                        <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="刪除" Click="Delete_Click" Margin="0,14,0,0"
                                ToolTip="從所有影片移除這個名字，影片本身不會被刪除" />
                        <TextBlock x:Name="HintText" Style="{StaticResource HintText}" Margin="2,12,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
