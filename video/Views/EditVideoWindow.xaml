<Window x:Class="Video.Views.EditVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增影片" Height="640" Width="600" MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <!-- 片名 -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="片名（必填）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TitleBox" PreviewKeyDown="TitleBox_PreviewKeyDown" TextChanged="TitleBox_TextChanged" />
                    <TextBlock x:Name="TitleError" Text="請輸入片名。" Visibility="Collapsed" FontSize="12.5"
                               Foreground="{StaticResource DangerBrush}" Margin="2,6,0,0" />
                </StackPanel>

                <!-- 演員 -->
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                    <TextBlock Text="演員（打名字按 Enter，可以加好幾位）" Style="{StaticResource FieldLabel}" />
                    <ItemsControl x:Name="ActorChips" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagChip}" Padding="10,1,2,1" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" Style="{StaticResource TagChipText}" FontSize="13" />
                                        <Button Style="{StaticResource ClearButton}" Tag="{Binding}" Click="RemoveActor_Click"
                                                Margin="2,0,0,0" Padding="4" ToolTip="移除這位演員">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="ActorInput" PreviewKeyDown="ActorInput_PreviewKeyDown" TextChanged="ActorInput_TextChanged" />
                    <!-- 打字時列出現有的演員：↑↓ 選擇、Enter 加入，也可以直接點 -->
                    <ListBox x:Name="ActorSuggestions" Style="{StaticResource SideList}" Visibility="Collapsed"
                             Focusable="False" MaxHeight="124" Margin="0,4,0,0"
                             PreviewMouseLeftButtonDown="ActorSuggestions_PreviewMouseLeftButtonDown" />
                </StackPanel>

                <!-- 性質 -->
                <DockPanel Margin="0,16,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="性質（可以選好幾種）" Style="{StaticResource FieldLabel}" />
                    <TextBox DockPanel.Dock="Bottom" x:Name="GenreInput" Margin="0,8,0,0" PreviewKeyDown="GenreInput_PreviewKeyDown"
                             Style="{StaticResource SearchBox}" Tag="打性質按 Enter：現有的會選取，沒有的會新增"
                             ToolTip="空白時再按一次 Enter 就是儲存" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="GenreChips" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource FacetChip}" Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" IsTabStop="False" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageText" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <Button Grid.Column="1" Content="取消" Click="Cancel_Click" Margin="8,0,0,0" ToolTip="關閉（Esc）" />
            <Button Grid.Column="2" x:Name="SaveNextButton" Content="儲存並新增下一部" Click="SaveNext_Click" Margin="8,0,0,0"
                    ToolTip="存好後繼續新增（Ctrl+Enter）" />
            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="儲存" Click="Save_Click" Margin="8,0,0,0"
                    ToolTip="儲存並關閉（Ctrl+S）" />
        </Grid>
    </Grid>
</Window>
